{
  "name": "@zaings/salsa",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc && node scripts/write-dts-stubs.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "test": "vitest",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "test:run": "vitest run",
    "check": "node scripts/check.mjs",
    "check:fast": "node scripts/check.mjs --fast",
    "check:changed": "node scripts/check.mjs --changed",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js . --pass-on-unpruned-suppressions",
    "lint:fast": "node scripts/check.mjs --fast --steps=lint",
    "lint:install": "npm ci --prefix tools/lint",
    "sanity": "node scripts/check-source-sanity.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@webgpu/types": "^0.1.54",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "gl-matrix": "^3.4.3",
    "sucrase": "^3.35.1",
    "wasm-package": "file:wasm/pkg"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@^7.3.1"
  },
  "files": [
    "dist",
    "wasm/pkg"
  ],
  "description": "A 2D vector rendering library using WebGPU & WASM, designed for seamless integration with web applications via TypeScript.",
  "main": "dist/main.cjs.js",
  "module": "dist/main.es.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.es.js",
      "require": "./dist/main.cjs.js",
      "types": "./dist/main.d.ts"
    },
    "./shape-manager": {
      "import": "./dist/shape-manager.es.js",
      "require": "./dist/shape-manager.cjs.js",
      "types": "./dist/shape-manager.d.ts"
    },
    "./world-manager": {
      "import": "./dist/world-manager.es.js",
      "require": "./dist/world-manager.cjs.js",
      "types": "./dist/world-manager.d.ts"
    }
  },
  "sideEffects": false,
  "keywords": [
    "2d",
    "vector",
    "webgl",
    "rust",
    "wasm",
    "typescript"
  ],
  "author": "Zain Syed",
  "license": "ISC"
}
