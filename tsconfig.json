{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable", "esnext", "dom"],
    "types": ["@webgpu/types", "node"], 
    "skipLibCheck": true,

    /* Module Resolution */
    "moduleResolution": "bundler", 
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,

    /* Emit Options */
    "outDir": "dist",
    "rootDir": "src",                  // explicit (TS7 requires it for emit; matches inferred root)
    "declaration": true,               // ✅ Generates `.d.ts` files
    "declarationMap": true,            // ✅ Links `.d.ts` files to source
    "emitDeclarationOnly": true,        // ✅ Prevents JavaScript emission
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src"]
}